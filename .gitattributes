# Keep scripts LF so they run in Git Bash, WSL and POSIX shells.
* text=auto eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
