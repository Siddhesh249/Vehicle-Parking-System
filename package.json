{
  "name": "vehicle-parking-system",
  "private": true,
  "scripts": {
    "start": "bash run.sh",
    "dev": "bash run.sh",
    "check": "bash test.sh",
    "test": "npm run test:server && npm run test:client",
    "test:all": "bash test.sh",
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client",
    "test:load": "k6 run loadtest/entry-concurrency.js",
    "seed": "npm run seed --prefix server",
    "lint": "npm run lint --prefix client",
    "format": "prettier --write \"*.{json,md,yml,yaml}\" \"client/**/*.{js,jsx,cjs,css,json}\" \"server/**/*.{js,cjs,json}\" \"loadtest/**/*.js\" \"DOCS/**/*.md\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"*.{json,md,yml,yaml}\" \"client/**/*.{js,jsx,cjs,css,json}\" \"server/**/*.{js,cjs,json}\" \"loadtest/**/*.js\" \"DOCS/**/*.md\" \".github/**/*.{yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
