{
  "name": "vehicle-parking-system",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node scripts/run.mjs",
    "dev": "node scripts/run.mjs",
    "check": "node scripts/check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "npm run test:server && npm run test:client",
    "test:all": "node scripts/check.mjs",
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client",
    "test:load": "k6 run loadtest/entry-concurrency.js",
    "seed": "npm run seed --prefix server",
    "lint": "npm run lint --prefix client",
    "format": "prettier --write \"*.{json,md,yml,yaml}\" \"scripts/**/*.mjs\" \"client/**/*.{js,jsx,cjs,css,json}\" \"server/**/*.{js,cjs,json}\" \"loadtest/**/*.js\" \"DOCS/**/*.md\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"*.{json,md,yml,yaml}\" \"scripts/**/*.mjs\" \"client/**/*.{js,jsx,cjs,css,json}\" \"server/**/*.{js,cjs,json}\" \"loadtest/**/*.js\" \"DOCS/**/*.md\" \".github/**/*.{yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
