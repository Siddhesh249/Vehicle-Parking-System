# Local development configuration.
# `npm start` creates this file for you (with a generated JWT secret) when it is
# missing. This file is git-ignored, so your local settings are never committed.

# MongoDB
# Leave MONGO_URI commented to connect to a local MongoDB without authentication.
# If no MongoDB is reachable, `npm start` starts a temporary one for that run and
# discards its data on exit. An explicit MONGO_URI is never silently replaced.
# MONGO_URI=mongodb://127.0.0.1:27017/vehicle_parking

# Credentials for an authenticated MongoDB. Leave these commented for a default
# local install; uncomment and fill them in only when your MongoDB requires auth.
# MONGO_USER=admin
# MONGO_PASSWORD=replace-with-local-password
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=vehicle_parking
# MONGO_AUTH_DB=admin

# JWT signing secret. `npm start` generates one when it creates this file.
# Leave it unset to use the development-only fallback (never do that in production).
# JWT_SECRET=replace-with-a-long-random-secret

PORT=5000
CLIENT_URL=http://127.0.0.1:5173

# Demo clock: five real seconds are billed as one parking hour.
SIMULATED_HOUR_SECONDS=5
# Background scan interval for automatic overstay detection.
OVERSTAY_SCAN_INTERVAL_MS=5000
# Set true to make the developer simulation routes return 404.
DISABLE_SIMULATION=false
# Set false to seed only accounts/spots (used by the isolated k6 database).
SEED_DEMO_DATA=true
