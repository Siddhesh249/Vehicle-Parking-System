MONGO_USER=admin
MONGO_PASSWORD=replace-with-local-password
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=vehicle_parking
MONGO_AUTH_DB=admin
# Optional URI override, useful for local MongoDB installs without authentication.
# MONGO_URI=mongodb://127.0.0.1:27017/vehicle_parking
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5173
# Automatic overstay threshold and background scan interval.
OVERSTAY_THRESHOLD_MINUTES=120
OVERSTAY_SCAN_INTERVAL_MS=30000
# Set true to make the developer simulation routes return 404.
DISABLE_SIMULATION=false
