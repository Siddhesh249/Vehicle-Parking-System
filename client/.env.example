# "mock" (default): in-memory demo data. "real": talk to the backend.
VITE_API_MODE=mock
# The repository launcher (`npm start`) sets this to "real" automatically, so you
# only need this file when starting the client on its own.
# Optional: override the Vite proxy target when the API is not on 127.0.0.1:5000.
# VITE_API_PROXY_TARGET=http://127.0.0.1:5000
